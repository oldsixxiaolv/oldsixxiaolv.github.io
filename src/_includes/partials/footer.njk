<footer class="foot">
  <div class="wrap foot__inner">
    <span>© {{ buildYear }} {{ site.author.name }}</span>
    <span class="foot__links">
      {% if site.author.email %}<a href="mailto:{{ site.author.email }}">Email</a>{% endif %}
      {% if site.author.github %}<a href="{{ site.author.github }}" target="_blank" rel="noopener noreferrer">GitHub</a>{% endif %}
      {% if site.author.orcid %}<a href="{{ site.author.orcid }}" target="_blank" rel="noopener noreferrer">ORCID</a>{% endif %}
      {# OpenAlex：开放学术图谱的作者实体。本人的档案是按 ORCID 精确反查
         出来的（不是手写猜测），档案里的 works 与本站论文条目对得上。
         它是 Semantic Scholar / CORE 等检索系统的上游，挂了更易被聚合。 #}
      {%- if site.author.openalex %}
      <a href="{{ site.author.openalex }}" target="_blank" rel="noopener noreferrer">OpenAlex</a>
      {%- endif %}
      {# 网盘入口。site.drive.url 目前是 null（还没定链到哪个网盘），
         判空后整条不渲染——页脚挂一个点开是空白/错误的链接比没有更糟。
         填上真实地址即可自动出现。放在页脚而不是主导航：主导航三个入口
         是学术定位，网盘塞进去会稀释它对访客的第一印象。 #}
      {%- if site.drive and site.drive.url %}
      <a href="{{ site.drive.url }}" target="_blank" rel="noopener noreferrer">{{ site.drive.label or "Cloud drive" }}</a>
      {%- endif %}
      {# —— RSS 订阅 ——
         订阅源同时收录**论文**与站内技术笔记（2026-10-19 第五轮改过：
         原来只取 collections.blog，而那个集合是空的，feed 里一条都没有，
         页脚却挂着一个 RSS 入口——点开永远是空白）。
         注意：本项目的 Nunjucks 没注册 comment 标签，全站注释一律用这种
         花括号井号写法，写成百分号 comment 会报 unknown block tag。 #}
      <a href="{{ '/feed.xml' | relUrl }}">RSS</a>
      <a href="{{ '/sitemap.xml' | relUrl }}">Sitemap</a>

      {# —— Edit on GitHub ——
         静态站没有后端，也就没有自建登录这一说。这条链接把「改内容」这件事
         落到 GitHub 自己的网页编辑器上：点开就是对应源文件的编辑界面，改完
         直接提交，CI 重新构建上线；没有推送权限的人点开也只能看不能提。
         路径不是猜的——各模板在自己的 front matter 里用 editPaths 显式声明
         （渲染后的 URL 和源文件不是一回事，猜必然错）。
         数组为空（repo 没配、或页面没声明）时整块不输出，不留空壳。 #}
      {%- if editPaths and site.author.repo and site.author.repoBranch %}
        {%- for e in editPaths %}
      <a href="{{ site.author.repo }}/edit/{{ site.author.repoBranch }}/{{ e.path }}"
         target="_blank" rel="noopener noreferrer"
         title="Edit {{ e.path }} on GitHub">{{ e.label or "Edit on GitHub" }}</a>
        {%- endfor %}
      {%- endif %}
    </span>
  </div>
</footer>
