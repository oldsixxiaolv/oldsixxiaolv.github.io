{# ============================================================================
  header.njk · 简化版 topbar（简约高级）
  ----------------------------------------------------------------------------
  - 左侧站名锁定块：等压线标记（内联 SVG，与首页 FIELD NOTE 卡的同心椭圆
    同一套视觉母题）+ 文字站名。SVG 自绘，不引第三方图标库。
  - 右侧文字导航，末位用 1px 竖线把主题切换按钮和导航项分开——这是全站
    唯一需要"层次"的地方，其余靠 hairline 就够了。
  - 高度 56px，hairline border-bottom
  ========================================================================== #}
{% set navItems = site.nav %}
{% set currentUrl = page.url %}

<header class="topbar">
  <div class="wrap topbar__inner">
    <a class="topbar__brand" href="{{ '/' | url }}"
       {% if page.url == "/" or page.url == "/MeteoHub/" %}aria-current="page"{% endif %}>
      {# 内联 SVG 不引外部资源：等压线同心环 + 中心低压点，和首页橙色卡片的
         同心椭圆是同一套母题。aria-hidden 让读屏只念文字站名。 #}
      <svg class="topbar__mark" width="21" height="21" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="9.25" opacity=".3"></circle>
        <circle cx="12" cy="12" r="5.5"></circle>
        <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"></circle>
      </svg>
      <span class="topbar__wordmark">{{ site.shortTitle }}</span>
    </a>

    <nav class="topbar__nav" aria-label="主导航">
      {% for item in navItems %}
        {% set href = item.href %}
        {# 只有站内根相对路径才可能是"当前页"。早期版本这里先算一个
           isExternal 变量却从来没用过，等于外链判定形同虚设。 #}
        {% set isCurrent =
             href and href.startsWith("/") and
             ((currentUrl == href) or
              (href != "/" and currentUrl and currentUrl.indexOf(href) == 0)) %}
        <a class="topbar__link"
           href="{{ href | url }}"
           {% if isCurrent %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
      <span class="topbar__sep" role="presentation" aria-hidden="true"></span>
      <button class="topbar__theme" type="button" data-theme-toggle aria-label="切换主题" aria-pressed="false">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path><path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path><path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>