{# ============================================================================
  base.njk · 全站骨架
  ----------------------------------------------------------------------------
  包含：HTML 头、字体外链、CSS 串接、theme 早期注入（避免 FOUC）、
        skip-link、topbar（partial）、main slot、footer（partial）、
        主脚本（theme + nav + main）、Person JSON-LD（全站学术画像）。
  ========================================================================== #}
<!DOCTYPE html>
<html lang="{{ site.locale or 'zh-CN' }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ description or site.description }}" />
  {# —— 页面标题的三级回落 ——
       一级：front-matter 的 `title`（首页 / 博客 / 关于 / 论文列表都是这条）
       二级：**论文页**——它的标题不在 front-matter 里，而是靠 `pubKey`
             指回 site.js 的 publications 条目。这里按 pubKey 取论文标题。
       三级：站点名（只有 404 之类的兜底页会走到这里）

       ⚠️ 为什么要回落：base.njk 原来只有「title or site.title」两级，
       论文页（第三轮才加的）front-matter 里**没有 title**，
       于是 `<title>` 和 og:title 全都退化成 "Yihang Lyu"——
       分享到社交平台时预览标题是作者名，浏览器标签页也是作者名，
       跟 /blog/ 那次（blog.njk 注释里记着）是同一个坑，只是又踩了一遍。
       论文标题现在直接取 publications 里的权威字段，不会再漏。 #}
  {%- set pubMeta = site.publications | pubByKey(pubKey) if pubKey else null -%}
  {%- set pageTitle = title or (pubMeta.title if pubMeta and pubMeta.title else null) -%}
  <title>{% if pageTitle %}{{ pageTitle }} · {{ site.shortTitle }}{% else %}{{ site.title }}{% endif %}</title>

  {# —— 字体外链（preconnect + preload + stylesheet） ——
       关键路径只留 3 个 Latin 字族（合计 19.9KB）：nav / UI / 首页大标题 /
       代码块都是 Latin，首屏立刻要用。
       Noto Serif SC 拆出去异步加载：光这一个字族的 Google Fonts CSS 就有 339KB
       （303 个 @font-face，CJK 按 unicode-range 切成上百个子集），占全站字体
       CSS 的 94.5%。挂在阻塞 stylesheet 上等于首屏先白等 339KB 才出字形。
       tokens.css 已为它备好 'Noto Serif SC Fallback'（size-adjust 105% +
       ascent/descent override，走本地 Songti SC），首屏先用系统衬线中文渲染，
       metrics 对齐后换 webfont 几乎看不出抖动 —— 与下面 components/layout/pages
       用的是同一套异步加载，行为一致。
       JetBrains Mono 故意留在关键路径：它的 CSS 只有 5KB，且代码块和页眉小标签
       首屏就要用到，拆出去只多一个请求、换不到什么字节。 —— #}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload" as="style"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:wght@400;600&family=JetBrains+Mono:wght@400;500&display=swap"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:wght@400;600&family=JetBrains+Mono:wght@400;500&display=swap"
  />
  <link
    rel="preload" as="style"
    href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;700&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;700&display=swap" />
  </noscript>

  {# —— Critical CSS：tokens + base 内联（first paint 即用，省一次 round trip） —— #}
  {% inlineCss "src/assets/css/tokens.css" %}
  {% inlineCss "src/assets/css/base.css" %}

  {# —— Non-critical CSS：components / layout / pages 异步加载
     preload + onload swap + <noscript> 同步 fallback —— #}
  <link rel="preload" as="style" href="{{ '/assets/css/components.css' | relUrl }}" onload="this.onload=null;this.rel='stylesheet'" />
  <link rel="preload" as="style" href="{{ '/assets/css/layout.css' | relUrl }}" onload="this.onload=null;this.rel='stylesheet'" />
  <link rel="preload" as="style" href="{{ '/assets/css/pages.css' | relUrl }}" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript>
    <link rel="stylesheet" href="{{ '/assets/css/components.css' | relUrl }}" />
    <link rel="stylesheet" href="{{ '/assets/css/layout.css' | relUrl }}" />
    <link rel="stylesheet" href="{{ '/assets/css/pages.css' | relUrl }}" />
  </noscript>

  {# —— a11y.css (Phase 2A.3)：与其余非关键 CSS 一起异步加载 ——
       注意它"必须最后生效"这件事并不依赖 link 标签的书写顺序（4 个 preload
       并行下载，落到 cascade 的先后是不确定的），真正的保障有两条：
         1. a11y.css 是全站唯一使用 !important 的样式表，它的覆盖规则不会
            被 components/layout/pages 的普通声明反超（base.css 里那段
            prefers-reduced-motion 与它重复且内容相同，不构成冲突）；
         2. 剩下的 :root 自定义属性覆盖（prefers-contrast / forced-colors 两块）
            只能和 tokens.css 竞争，而 tokens.css 是内联在 head 更靠前的 <style>，
            异步样式表总是追加到 head 末尾，永远排在其后。
       所以把它放最后只是保持可读性，真正让它安全的是上面两条。 —— #}
  <link rel="preload" as="style" href="{{ '/assets/css/a11y.css' | relUrl }}" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript>
    <link rel="stylesheet" href="{{ '/assets/css/a11y.css' | relUrl }}" />
  </noscript>

  {# —— 打印样式 ——
       media="print" 是关键：屏幕浏览时浏览器**不会下载这个文件**，
       所以它对首屏带宽零影响；只有真正打印 / 导出 PDF 时才拉下来。
       不用 preload + onload 那套异步换装——media 条件本身就是按需加载。

       用途见 src/assets/css/print.css 顶部注释：让带高亮和批注的论文
       能导出成 PDF（此前全站没有任何 @media print）。 #}
  <link rel="stylesheet" media="print" href="{{ '/assets/css/print.css' | relUrl }}" />

  {% block extraHead %}{% endblock %}

  {# —— Favicon —— #}
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | relUrl }}" />

  {# —— canonical link（GH Pages 子路径下由 pathPrefix 自动处理 page.url） —— #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  {# 备用 hreflang：主站点是中英混排，当前只声明默认 locale，避免误判多语言版本 #}
  <link rel="alternate" hreflang="{{ site.locale or 'zh-CN' }}" href="{{ site.url }}{{ page.url }}" />
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url }}" />

  {# —— RSS 订阅源（feed autodiscovery）——
       <link rel="alternate" type="application/rss+xml"> 是订阅源的标准发现方式：
       浏览器与阅读器的"订阅"按钮会自动认它，不必靠页脚那一个普通链接。
       href 走 | relUrl（相对路径），与全站"整个文件夹扔到哪都能跑"的原则一致。 #}
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} · Publications and notes" href="{{ '/feed.xml' | relUrl }}" />

  {# —— Google Scholar / Highwire 引用元数据 ——
       ⚠️ 这块和下面的 JSON-LD **不是一回事**：Google Scholar 只读
       citation_* <meta>，不读 JSON-LD。没有它，论文永远进不了
       Google Scholar 的索引。文件内部有详细说明。 #}
  {% include "partials/citation-meta.njk" %}

  {# =====================================================================
       Open Graph（所有页必备；paper 页可设置 front-matter `cover: "/path/to/img"` 覆盖）
       ===================================================================== #}
  {% set ogTitle = pageTitle or site.title %}
  {% set ogDesc = description or site.description %}
  {# og:image:alt 描述的是**图本身**（姓名 / 职位 / 单位 / 研究方向），
     不是 og:title 的复述。页面标题由 og:title 单独承担，alt 再抄一遍就会
     出现 "Yihang Lyu · PhD Student · Yihang Lyu, PhD Student" 这种重复。 #}
  {% set ogCardAlt = "MeteoHub — " + site.author.name + ", " + site.author.jobTitle + " at " + site.author.affiliationShort %}

  <meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}" />
  <meta property="og:site_name" content="{{ site.title }}" />
  <meta property="og:title" content="{{ ogTitle }}" />
  <meta property="og:description" content="{{ ogDesc }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:locale" content="{{ site.locale or 'zh_CN' }}" />

  {# ---------------------------------------------------------------------
       og:image override 机制（Phase 2B.1）：
         · 默认 → 全站统一的三尺寸静态图（UI/UX Pro Max 设计 · Phase 1.3）
         · 覆盖 → 当 front-matter `cover` 存在时，单图替换三尺寸
                  （论文页用 paper-specific 封面；保持社交平台覆盖简单可预测）
       --------------------------------------------------------------------- #}
  {% if cover %}
    {# ---------------------------------------------------------------------
         cover 解析（og:image 与 twitter:image 共用同一个 coverUrl）
         解析顺序：
           1) http(s):// 开头        → 已是绝对 URL，原样使用
           2) / 开头                 → 站点根相对，拼 site.url + cover
           3) 其余（裸文件名）        → 页面同级，拼 site.url + page.url + cover
         第 3 条是内容侧的写法：src/content/<section>/<slug>/ 里写
         `cover: "cover.svg"`，而 permalink 是 /<section>/<slug>/、封面就拷在
         index.html 同级，所以要拿 page.url 补出 section/slug 段。
         早先这里按站点根拼，产出过 https://.../MeteoHub/cover.svg（少一段），
         所有论文/博客/作品的社交分享图都是 404。
         page.url 对这三个 section 恒以 / 结尾，直接拼接即可。 #}
    {% if cover.startsWith('http') %}
      {% set coverUrl = cover %}
    {% elif cover.startsWith('/') %}
      {% set coverUrl = site.url + cover %}
    {% else %}
      {% set coverUrl = site.url + page.url + cover %}
    {% endif %}
    {# og:image:type 必须与实际文件格式一致：cover 可能是 jpg/png/svg/webp，
       写死 image/png 会让部分抓取器按错误的 MIME 解析图片（论文页用的是
       JPEG 成果图，之前被标成 png）。这里按扩展名推导。 #}
    {% set coverExt = coverUrl.split('?')[0].split('.').pop() | lower %}
    {% if coverExt == 'jpg' or coverExt == 'jpeg' %}
      {% set coverMime = 'image/jpeg' %}
    {% elif coverExt == 'png' %}
      {% set coverMime = 'image/png' %}
    {% elif coverExt == 'webp' %}
      {% set coverMime = 'image/webp' %}
    {% elif coverExt == 'gif' %}
      {% set coverMime = 'image/gif' %}
    {% elif coverExt == 'svg' %}
      {% set coverMime = 'image/svg+xml' %}
    {% else %}
      {% set coverMime = 'image/png' %}
    {% endif %}
    <meta property="og:image" content="{{ coverUrl }}" />
    <meta property="og:image:secure_url" content="{{ coverUrl }}" />
    <meta property="og:image:type" content="{{ coverMime }}" />
    {%- if coverWidth %}
    <meta property="og:image:width" content="{{ coverWidth }}" />
    {%- endif %}
    {%- if coverHeight %}
    <meta property="og:image:height" content="{{ coverHeight }}" />
    {%- endif %}
    {# alt 描述的是**这张图**。默认 alt 描述的是作者身份，论文页的 cover 是
       论文成果图，用作者身份当 alt 属于图文不符；内容页可用 front-matter
       `coverAlt` 覆盖。 #}
    <meta property="og:image:alt" content="{{ coverAlt or ogCardAlt }}" />
  {% else %}
    {# 多尺寸 og:image（默认 fallback；社交平台按 slot 尺寸自动选图）：
         1. 1200×630  — FB / LinkedIn / Twitter summary_large_image 默认
         2. 1080×1080 — Twitter / Instagram / IG Story 正方形
         3. 1500×500  — X header-like 横幅
         所有图在 src/assets/img/og/ 下（SVG 源 + PNG 导出）。
    #}
    <meta property="og:image" content="{{ site.url }}/assets/img/og/og-1200x630.png" />
    <meta property="og:image:secure_url" content="{{ site.url }}/assets/img/og/og-1200x630.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ ogCardAlt }}" />

    <meta property="og:image" content="{{ site.url }}/assets/img/og/og-1080x1080.png" />
    <meta property="og:image:secure_url" content="{{ site.url }}/assets/img/og/og-1080x1080.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content="{{ ogCardAlt }} (square)" />

    <meta property="og:image" content="{{ site.url }}/assets/img/og/og-1500x500.png" />
    <meta property="og:image:secure_url" content="{{ site.url }}/assets/img/og/og-1500x500.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1500" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:alt" content="{{ ogCardAlt }} (wide)" />
  {% endif %}

  {# =====================================================================
       Twitter Card（summary_large_image：需要 1200×630 以上的图片）
       · 默认 → 1200×630 静态 PNG
       · 覆盖 → 当 front-matter `cover` 存在时，替换为 cover（与 og:image 同步）
       ===================================================================== #}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ ogTitle }}" />
  <meta name="twitter:description" content="{{ ogDesc }}" />
  {% if cover %}
    <meta name="twitter:image" content="{{ coverUrl }}" />
    <meta name="twitter:image:alt" content="{{ coverAlt or (ogTitle + ' · ' + site.author.name + ', ' + site.author.jobTitle) }}" />
  {% else %}
    <meta name="twitter:image" content="{{ site.url }}/assets/img/og/og-1200x630.png" />
    <meta name="twitter:image:alt" content="{{ ogTitle }} · {{ site.author.name }}, {{ site.author.jobTitle }}" />
  {% endif %}
  {# —— Twitter/X 身份句柄（2026-10-19 第五轮改）——
       ⚠️ 身份类字段与普通外链**语义不同**：写错不是"死链"，
       而是**向搜索引擎声明"本站/本文属于这个账号"**。
       此前这里写死了两个猜测值：
         twitter:site    = @meteohub     → x.com/meteohub 返回 200，
                                          账号存在，但**不是本人的**；
         twitter:creator = @oldsixxiaolv → x.com/oldsixxiaolv 返回 404，
                                          X 上查无此号（是把 GitHub 句柄直接复用）。
       也就是说，站点当时正在对外声明归属给一个陌生人的账号和一个不存在的账号。
       正确做法：**没有真实句柄就整对不输出**，不拿猜测值凑"看起来完整"。
       在 src/_data/site.js 的 site.author 里填上真实句柄即自动出现。 #}
  {%- if site.author.twitterSite %}
  <meta name="twitter:site" content="{{ site.author.twitterSite }}" />
  {%- endif %}
  {%- if site.author.twitterCreator %}
  <meta name="twitter:creator" content="{{ site.author.twitterCreator }}" />
  {%- endif %}

  {# =====================================================================
       Person JSON-LD（全站学术画像 · Google 知识图谱）
       sameAs / knowsAbout 由 site.author 提供（详见 src/_data/site.js）
       ===================================================================== #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ site.author.name }}",
    "image": "{{ site.url }}{{ site.author.photo.portrait }}",
    "alternateName": "{{ site.author.alternateName or site.author.fullName or '' }}",
    "givenName": "{{ site.author.givenName or '' }}",
    "familyName": "{{ site.author.familyName or '' }}",
    "jobTitle": "{{ site.author.jobTitle or site.author.role }}",
    "description": "{{ site.author.bio or site.author.research }}",
    "url": "{{ site.url }}{{ page.url }}",
    "sameAs": {{ site.author.sameAs | dump | safe }},
    "knowsAbout": {{ site.author.knowsAbout | dump | safe }},
    "affiliation": {
      "@type": "Organization",
      {# 用英文全称（affiliationEn）而不是中文简称：全站已统一英文，
         而 schema.org 的 Organization name 是给跨语言检索做实体消歧的，
         英文写法匹配面更广。中文名保留在 alternateName 与页面正文里。 #}
      "name": "{{ site.author.affiliationEn or site.author.affiliation }}",
      "url": "{{ site.author.affiliationUrl or '' }}"
    },
    {# 教育经历：2022–2026 兰州大学大气科学学院本科。alumniOf 是 Person 的
       标准属性，用来把学位授予机构也纳入实体识别——尤其是当你已经和该校的
       研究者合作发表过论文时（2026 JGR 的 affiliation 就是 Lanzhou University），
       这条能把两个身份线索串起来。 #}
    {%- for e in site.author.education %}
    {%- if e.institutionShort == 'LZU' %}
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "{{ e.institution }}"
    },
    {%- endif %}
    {%- endfor %}
    "email": "{{ site.author.email or '' }}",
    "workLocation": {
      "@type": "Place",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Beijing",
        "addressCountry": "CN"
      }
    }
  }
  </script>

  {# —— ScholarlyArticle：论文的结构化数据 ——
     上面那段 Person 描述"我是谁"，这段描述"我产出过什么"。两边用同一个
     ORCID 串起来，搜索引擎才能把它们识别成同一实体。

     ⚠️ 职责边界（2026-10-19 更正）：**Google Scholar 不读 JSON-LD**，
     它只认 Highwire 的 citation_* <meta> 标签（partials/citation-meta.njk）。
     这段 JSON-LD 服务的是通用 schema.org 消费方（Bing 实体、Wikipedia、
     Google 普通检索的富结果）。两套都得有，但不是同一套——此前这里
     注释写成"Google Scholar 读的就是 ScholarlyArticle"，是错的。

     数据源与 /papers/ 页、BibTeX 导出完全一致（site.publications），三处
     不可能出现"这里有、那里没有"。每条缺字段就不输出该字段，不留空值。

     顶层用 @graph 而不是裸数组：@graph 是 schema.org 表示"一组实体"的
     规范写法（Google 官方文档推荐），裸数组虽然也是合法 JSON-LD，但
     在多实体场景下兼容性不如 @graph。

     excludeKey：当前页自己就是某篇论文时（/papers/<slug>/），那一篇由
     paper.njk 输出更完整的 ScholarlyArticle（含摘要、逐人 ORCID、ISSN）。
     若这里再输出一次，同一篇论文会在同一页上出现两个实体描述（url 一个
     指向出版商、一个指向本页），容易让消费方当成两件不同的工作。 #}
  {%- set articles = site.publications | jsonLdArticles(site.author.orcid, pubKey) -%}
  {%- if articles.length %}
  <script type="application/ld+json">
  {{ { "@context": "https://schema.org", "@graph": articles } | dump | safe }}
  </script>
  {%- endif %}

  {% block structuredData %}{% endblock %}

  {# —— 主题早期注入：避免主题闪烁（FOUC）—— #}
  <script>
    (function () {
      try {
        var saved = localStorage.getItem("meteohub-theme");
        var sys = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        var t = saved || sys;
        if (t === "dark") document.documentElement.setAttribute("data-theme", "dark");
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>

  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  {# —— 主脚本：theme + nav + reading progress —— #}
  <script type="module" src="{{ '/assets/js/main.js' | relUrl }}"></script>
</body>
</html>