---
layout: layouts/base.njk
---
{# ============================================================================
  paper.njk · 论文精读详情页 layout（简约高级版）
  ----------------------------------------------------------------------------
  - 顶部 h1 + 一行 metadata（title / authors / year / venue / DOI 链接）
  - 正文：paper-reader.js 双栏精读
  - 底部：回到 papers 列表
  - 顶部注入 ScholarlyArticle JSON-LD（Google Scholar / Rich Results 关键）
    （注：base.njk 用 {{ content | safe }} 注入，JSON-LD 写在这里的 <script>
     会进入 <main> 末尾，对 Google 解析没有影响——脚本型 LD 放 body 仍合法。）
  ========================================================================== #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  "headline": {{ title | dump | safe }},
  "name": {{ title | dump | safe }},
  "url": "{{ site.url }}{{ page.url }}",
  "datePublished": "{{ year or (page.date | date('yyyy')) }}-01-01",
  "dateModified": "{{ page.date | dateToIso }}",
  "inLanguage": "{% if site.locale and 'zh' in site.locale %}zh-CN{% else %}en{% endif %}",
  "isAccessibleForFree": true,
  "license": "https://creativecommons.org/licenses/by-nc/4.0/",
  "publisher": {
    "@type": "Organization",
    "name": {{ site.author.affiliation | dump | safe }},
    "url": "{{ site.author.affiliationUrl or '' }}"
  },
  "author": [
    {# authors 既可能是数组（trmm / microphysics）也可能是单个字符串（holton）。
       字符串直接进 for 循环会拿到一个"整串作者名"元素，a.affiliation 永远是
       undefined，下面两个 affiliation 分支都走不到。统一包成数组。 #}
    {% set authorList = authors if (authors and authors is not string) else [authors] %}
    {% if authors and authors.length %}
      {% for a in authorList %}
        {% set aname = a.name or a %}
        {% set isMe = (aname == site.author.name) or (aname == site.author.alternateName) or (aname == 'Yihang Lv') or (aname == site.author.nameAsPublished) %}
        {
          "@type": "Person",
          "name": {{ aname | dump | safe }}
          {% if isMe %},
          "alternateName": {{ (site.author.alternateName or site.author.fullName or '') | dump | safe }},
          "jobTitle": {{ (site.author.jobTitle or site.author.role or '') | dump | safe }},
          "url": "{{ site.url }}/",
          "sameAs": {{ site.author.sameAs | dump | safe }},
          "affiliation": {
            "@type": "Organization",
            "name": {{ site.author.affiliation | dump | safe }},
            "url": "{{ site.author.affiliationUrl or '' }}"
          }
          {% elif a.affiliation %},
          "affiliation": {
            "@type": "Organization",
            "name": {{ a.affiliation | dump | safe }}
          }
          {% elif affiliation %},
          "affiliation": {
            "@type": "Organization",
            "name": {{ affiliation | dump | safe }}
          }
          {% endif %}
        }{% if not loop.last %},{% endif %}
      {% endfor %}
    {% else %}
      {
        "@type": "Person",
        "name": {{ site.author.name | dump | safe }},
        "url": "{{ site.url }}/",
        "sameAs": {{ site.author.sameAs | dump | safe }},
        "affiliation": {
          "@type": "Organization",
          "name": {{ site.author.affiliation | dump | safe }},
          "url": "{{ site.author.affiliationUrl or '' }}"
        }
      }
    {% endif %}
  ],
  {% if journal or venue %}
  "publication": {
    "@type": "Periodical",
    "name": {{ (journal or venue) | dump | safe }}
  },
  {% endif %}
  {% if doi %}
  {# doi 走 dump | safe：Nunjucks 不知道这里在 <script> 里，会按 HTML 转义，
     DOI 里的 <1414:OTROMC> 会变成 &lt;1414:OTROMC&gt; 写进 JSON-LD，
     Google 侧拿到的就是一个坏掉的标识符。 #}
  "identifier": {{ ("https://doi.org/" + doi) | dump | safe }},
  "sameAs": [
    {{ ("https://doi.org/" + doi) | dump | safe }}
  ],
  {% endif %}
  "keywords": {{ (keywords or tags or []) | dump | safe }},
  {# description / excerpt 都可能缺失（如 holton）。| dump 对 undefined 输出空串，
     会渲染成 "description": , 让整块 JSON-LD 语法失效、Google 直接丢弃
     ScholarlyArticle，所以必须兜底到一定存在的 title。 #}
  "description": {{ (description or excerpt or title or '') | dump | safe }},
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  }
}
</script>

<div class="paper-reader-wrap">
<article class="paper">
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
  <header class="paper-head">
    <h1>{{ title }}</h1>
    {# 元信息分三层：作者 / 出处+状态 / 链接。
       原来把 7 个作者 + 期刊 + 年份 + 状态挤在同一行 14px 灰字里，
       作者和出处同字号同色，谁也认不出来；这里拆开之后「谁写的」和
       「登在哪」各自成行，中间那栏正文才是页面上最重的一层。 #}
    {% if authors %}
    <p class="paper-head__authors">{% if authors is string %}{{ authors }}{% else %}{{ authors | join(", ") }}{% endif %}</p>
    {% endif %}
    <p class="paper-head__meta">
      {# frontmatter 里写的是 journal（三篇论文都是），模板原来只读 venue，
         结果期刊名一次都没渲染出来 —— 上面 JSON-LD 用的是 journal or venue，
         这里对齐成同一个顺序。 #}
      {% if journal or venue %}<span class="paper-head__venue">{{ journal or venue }}</span>{% endif %}
      {% if year %}<span class="dot" aria-hidden="true">·</span><span>{{ year }}</span>{% endif %}
      {% if readingStatus %}<span class="dot" aria-hidden="true">·</span><span class="paper-head__status status--{{ readingStatus }}">{{ readingStatus | statusLabel }}</span>{% endif %}
      {% if doi or pdf %}
      <span class="dot" aria-hidden="true">·</span>
      <span class="paper-head__links">
        {% if doi %}<a href="https://doi.org/{{ doi }}" target="_blank" rel="noopener noreferrer">DOI</a>{% endif %}
        {% if pdf %}<a href="{{ pdf }}" target="_blank" rel="noopener noreferrer">PDF</a>{% endif %}
      </span>
      {% endif %}
    </p>
  </header>

  <div class="paper-body">
    {{ content | safe }}
  </div>

  <p class="paper-footer"><a href="{{ '/papers/' | relUrl }}">← 回到论文精读列表</a></p>
</article>
</div>

{# paper-reader.css 仅 paper 页用，inline 成 <style> 让浏览器立即解析。
   注意：Eleventy 的 `layout:` 是数据级包装而非 Nunjucks `extends`，所以
   `{% block extraHead %}` 不会跨模板注入到 base.njk 的 head。这里用 inline 替代
   `<link rel="stylesheet">`，省一次 round trip 且与上面的 ScholarlyArticle JSON-LD
   一样紧随 <main>，不影响渲染。 #}
{% inlineCss "src/assets/css/paper-reader.css" %}

{# paper-reader/main.js 是拆分后的入口（Phase 2B.6）。
   · 动态 import：仅 paper 页加载，其他页面零开销
   · 浏览器自动并行 fetch 子模块（toc / annotations / highlight / reading-progress / theme）
   · 解析完 annotations 再挂 highlight，二者通过返回值解耦 #}
<script type="module">
  const paperRoot = document.querySelector("article.paper");
  if (paperRoot) {
    const { initPaperReader } = await import("{{ '/assets/js/paper-reader/main.js' | relUrl }}");
    initPaperReader({
      paperRoot,
      annotationsUrl: "{{ '/content/papers/' | relUrl }}{{ slug or page.fileSlugStem }}/annotations.json",
    });
  }
</script>