{
  "name": "meteohub",
  "version": "1.0.0",
  "description": "MeteoHub · 个人学术站点（学术主页 + 技术笔记 + 论文）",
  "private": true,
  "scripts": {
    "check:css": "node scripts/check-css-braces.cjs && node scripts/check-dead-css.cjs",
    "check:lang": "node scripts/check-lang.cjs",
    "check:site": "node scripts/verify-site.cjs",
    "check:wrap": "node scripts/check-wrapping.cjs",
    "check:gates": "node scripts/check-gates-wired.cjs",
    "check:log-sections": "node scripts/check-log-sections.cjs",
    "check:tracked-refs": "node scripts/check-tracked-refs.cjs",
    "build": "npm run check:gates && npm run check:tracked-refs && npm run check:log-sections && npm run check:css && npm run check:wrap && eleventy && npm run check:tool-routes && npm run check:site && npm run check:image && npm run check:lang && npm run check:a11y && npm run check:print-theme && npm run check:copy && npm run check:overflow && npm run check:artifact && npm run check:readme && npm run check:readme-selftest && npm run check:jsonld && npm run check:identity && npm run check:identity-derivation && npm run check:citation-meta && npm run check:citation-cff && npm run check:citation-cff-selftest && npm run check:live-selftest",
    "serve": "eleventy --serve --quiet --port=8080",
    "check:a11y": "node scripts/check-a11y.cjs",
    "check:copy": "node scripts/check-copy-export.cjs",
    "check:overflow": "node scripts/check-overflow.cjs",
    "check:artifact": "node scripts/check-artifact-metadata.cjs",
    "check:jsonld": "node scripts/check-jsonld.cjs",
    "check:identity": "node scripts/check-identity-handles.cjs",
    "check:identity-derivation": "node scripts/check-identity-derivation.cjs",
    "check:image": "node scripts/check-image-assets.cjs",
    "check:tool-routes": "node scripts/check-tool-routes.cjs",
    "check:print-theme": "node scripts/check-print-theme.cjs",
    "check:citation-meta": "node scripts/check-citation-meta.cjs",
    "check:citation-cff": "node scripts/check-citation-cff.cjs",
    "check:citation-cff-selftest": "node scripts/test-citation-cff.cjs",
    "gen:citation-cff": "node scripts/check-citation-cff.cjs --write",
    "check:live": "node scripts/check-live-site.cjs",
    "check:live-selftest": "node scripts/test-live-site.cjs",
    "check:readme": "node scripts/check-readme.cjs",
    "check:readme-selftest": "node scripts/test-readme.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "luxon": "^3.4.0",
    "markdown-it": "^14.1.0"
  }
}
