{
  "name": "meteohub",
  "version": "1.0.0",
  "description": "MeteoHub · 个人学术站点 (作品集 + 博客 + 论文精读)",
  "private": true,
  "scripts": {
    "check:css": "node scripts/check-css-braces.cjs",
    "build": "npm run check:css && eleventy",
    "serve": "eleventy --serve --quiet --port=8080"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "luxon": "^3.4.0",
    "markdown-it": "^14.1.0"
  },
  "optionalDependencies": {
    "marked": "^12.0.0"
  }
}
