{
  "name": "meteohub",
  "version": "1.0.0",
  "description": "MeteoHub · 个人学术站点（学术主页 + 技术笔记 + 论文）",
  "private": true,
  "scripts": {
    "check:css": "node scripts/check-css-braces.cjs && node scripts/check-dead-css.cjs",
    "check:lang": "node scripts/check-lang.cjs",
    "check:site": "node scripts/verify-site.cjs",
    "check:wrap": "node scripts/check-wrapping.cjs",
    "check:gates": "node scripts/check-gates-wired.cjs",
    "build": "npm run check:gates && npm run check:css && npm run check:wrap && eleventy && npm run check:site && npm run check:lang && npm run check:a11y && npm run check:copy",
    "serve": "eleventy --serve --quiet --port=8080",
    "check:a11y": "node scripts/check-a11y.cjs",
    "check:copy": "node scripts/check-copy-export.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "luxon": "^3.4.0",
    "markdown-it": "^14.1.0"
  }
}
